{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "vcm": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "api-server": {
      "root": ".",
      "framework": "express",
      "entrypoint": "server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api-server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "vcm" }
    }
  ]
}
